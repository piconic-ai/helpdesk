{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "helpdesk",
  "main": "worker.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helpdesk",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "RAW", "bucket_name": "helpdesk-mail" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "helpdesk-jobs" }],
    "consumers": [
      {
        "queue": "helpdesk-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "helpdesk-dead-letters",
      },
    ],
  },
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["17 * * * *"] },
}
