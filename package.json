{
  "name": "@piconic-ai/helpdesk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && wrangler dev",
    "dev:widget": "pnpm build && node examples/widget/demo.mjs",
    "dev:demo": "pnpm build && node tests/ui/demo.mjs",
    "build": "vite build && unocss && wrangler deploy --dry-run --outdir dist/worker",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:ui": "playwright test -c playwright.ui.config.mjs",
    "test:ux": "playwright test -c playwright.ux.config.mjs"
  },
  "dependencies": {
    "@barefootjs/client": "^0.40.2",
    "@barefootjs/hono": "^0.40.2",
    "@barefootjs/jsx": "^0.40.2",
    "@barefootjs/shared": "^0.40.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.6.0",
    "jose": "^6.2.15",
    "jpeg-js": "^0.4.4",
    "marked": "^18.2.1",
    "pngjs": "^7.0.0",
    "postal-mime": "^2",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@barefootjs/cli": "^0.40.2",
    "@barefootjs/test": "^0.40.2",
    "@barefootjs/vite": "^0.40.2",
    "@cloudflare/workers-types": "^4.20260702.1 || ^5.20260708.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/sanitize-html": "^2.16.2",
    "@unocss/cli": "^66.0.0",
    "@unocss/preset-wind4": "^66.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "^4.14.1",
    "fast-check": "^4",
    "miniflare": "5.20261103.0-beta",
    "oxfmt": "0.76.0",
    "playwright": "1.64.1",
    "postcss": "8.5.33",
    "typescript": "^5.6.0",
    "unocss": "^66.0.0",
    "vite": "^6.0.0",
    "vitest": "4.1.12",
    "wrangler": "^4.0.0"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "helpdesk": "./cli/helpdesk.mjs"
  }
}
